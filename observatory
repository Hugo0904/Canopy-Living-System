#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
import webbrowser
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parent
DATA_DIR = ROOT / ".data"
RUNTIME_FILE = DATA_DIR / "runtime.json"
LOG_FILE = DATA_DIR / "server.log"
DEFAULT_CANOPY_ROOT = (ROOT.parent / "Canopy").resolve()


def run(
    command: list[str],
    *,
    timeout: int = 900,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
        env=env,
    )


def venv_python() -> Path:
    return ROOT / ".venv" / ("Scripts/python.exe" if os.name == "nt" else "bin/python")


def resolve_canopy_root(raw: str) -> Path:
    return Path(raw or os.getenv("CANOPY_ROOT", "") or DEFAULT_CANOPY_ROOT).expanduser().resolve()


def discover_node() -> tuple[Path, str]:
    candidates: list[Path] = []
    for raw in (os.getenv("NVM_BIN", ""), os.getenv("VOLTA_HOME", "")):
        if raw:
            candidates.append(Path(raw).expanduser() / ("bin/node" if raw == os.getenv("VOLTA_HOME", "") else "node"))
    path_node = shutil.which("node")
    if path_node:
        candidates.append(Path(path_node))
    candidates.extend(sorted((Path.home() / ".nvm" / "versions" / "node").glob("*/bin/node")))
    candidates.extend([Path("/opt/homebrew/bin/node"), Path("/usr/local/bin/node")])

    discovered: list[tuple[tuple[int, int, int], Path, str]] = []
    seen: set[Path] = set()
    for candidate in candidates:
        resolved = candidate.expanduser().resolve()
        if resolved in seen or not resolved.is_file():
            continue
        seen.add(resolved)
        result = run([str(resolved), "--version"])
        if result.returncode:
            continue
        version = result.stdout.strip()
        try:
            parts = version.lstrip("v").split(".")
            parsed = (int(parts[0]), int(parts[1]), int(parts[2]))
        except (IndexError, ValueError):
            continue
        discovered.append((parsed, resolved, version))
    if not discovered:
        raise RuntimeError("Node.js is required to build Canopy Living System")
    _, node, version = max(discovered, key=lambda item: item[0])
    return node, version


def node_tooling() -> tuple[list[str], dict[str, str]]:
    node, version_text = discover_node()
    npm_cli = node.parent.parent / "lib" / "node_modules" / "npm" / "bin" / "npm-cli.js"
    npm_raw = str(node.parent / ("npm.cmd" if os.name == "nt" else "npm"))
    if not Path(npm_raw).is_file():
        npm_raw = shutil.which("npm") or ""
    if not npm_cli.is_file() and not npm_raw:
        raise RuntimeError(f"npm was not found for {node}")
    command = [str(node), str(npm_cli)] if npm_cli.is_file() else [npm_raw]
    env = {
        **os.environ,
        "PATH": str(node.parent) + os.pathsep + os.environ.get("PATH", ""),
    }
    try:
        major = int(version_text.lstrip("v").split(".", 1)[0])
    except ValueError as exc:
        raise RuntimeError(f"Could not parse Node.js version: {version_text}") from exc
    if major < 20:
        raise RuntimeError(f"Node.js 20 or newer is required; found {version_text}")
    return command, env


def require_success(result: subprocess.CompletedProcess[str], label: str) -> None:
    if result.returncode == 0:
        return
    detail = "\n".join(
        part for part in ((result.stderr or "").strip(), (result.stdout or "").strip()) if part
    ) or f"exit code {result.returncode}"
    raise RuntimeError(f"{label} failed: {detail}")


def reconcile_canopy_hooks(canopy_root: Path, *, mode: str) -> dict[str, object]:
    """Ask the owning Canopy lifecycle to reconcile its managed Codex hooks."""
    result = run(
        [
            sys.executable,
            str(canopy_root / "canopy"),
            "repair",
            "codex-hooks",
            "--mode",
            mode,
            "--json",
        ],
        timeout=60,
    )
    require_success(result, "Canopy managed-hook reconciliation")
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(
            f"Canopy managed-hook reconciliation returned invalid JSON: {exc}"
        ) from exc
    if not isinstance(payload, dict) or payload.get("status") != "PASS":
        raise RuntimeError("Canopy managed-hook reconciliation did not verify PASS")
    return payload


def install(canopy_root: Path) -> None:
    if not (canopy_root / "canopy").is_file():
        raise RuntimeError(f"Canopy CLI not found: {canopy_root / 'canopy'}")
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    if not venv_python().is_file():
        require_success(run([sys.executable, "-m", "venv", str(ROOT / ".venv")]), "venv")
    require_success(
        run(
            [
                str(venv_python()),
                "-m",
                "pip",
                "install",
                "--disable-pip-version-check",
                "-r",
                "requirements.txt",
            ]
        ),
        "Python dependency installation",
    )
    npm, node_env = node_tooling()
    require_success(run([*npm, "install"], env=node_env), "frontend dependency installation")
    build_frontend(npm=npm, node_env=node_env)
    env = {**os.environ, "CANOPY_ROOT": str(canopy_root)}
    result = subprocess.run(
        [str(venv_python()), "-c", "from backend.app.main import initialize_runtime; initialize_runtime()"],
        cwd=ROOT,
        env=env,
        text=True,
        capture_output=True,
        check=False,
        timeout=120,
    )
    require_success(result, "database initialization")
    reconcile_canopy_hooks(canopy_root, mode="installed")


def build_frontend(
    *,
    npm: list[str] | None = None,
    node_env: dict[str, str] | None = None,
) -> None:
    if npm is None or node_env is None:
        npm, node_env = node_tooling()
    require_success(run([*npm, "run", "build"], env=node_env), "frontend build")


def load_runtime() -> dict[str, object]:
    if not RUNTIME_FILE.is_file():
        return {}
    try:
        payload = json.loads(RUNTIME_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return payload if isinstance(payload, dict) else {}


def process_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def canopy_instance(canopy_root: Path) -> str:
    return hashlib.sha256(str(canopy_root.resolve()).encode("utf-8")).hexdigest()[:16]


def endpoint_healthy(port: int, canopy_root: Path | None = None) -> bool:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/health", timeout=1) as response:
            if response.status != 200:
                return False
            payload = json.loads(response.read().decode("utf-8"))
            if not isinstance(payload, dict) or payload.get("service") != "canopy-living-system":
                return False
            if canopy_root is None:
                return True
            # One-release compatibility lets an older local process be
            # stopped safely by matching its exact (formerly exposed) root.
            return (
                payload.get("canopy_instance") == canopy_instance(canopy_root)
                or payload.get("canopy_root") == str(canopy_root.resolve())
            )
    except (OSError, urllib.error.URLError, json.JSONDecodeError):
        return False


def running_runtime(canopy_root: Path | None = None) -> dict[str, object]:
    runtime = load_runtime()
    try:
        pid = int(runtime.get("pid", 0))
        port = int(runtime.get("port", 0))
    except (TypeError, ValueError):
        return {}
    runtime_root = str(runtime.get("canopy_root", ""))
    if canopy_root is not None and runtime_root != str(canopy_root.resolve()):
        return {}
    return runtime if process_alive(pid) and endpoint_healthy(port, canopy_root) else {}


def available_port(preferred: int) -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        # Match uvicorn's reusable listener behavior so a clean restart can
        # reclaim 8765, but never drift into a second, surprising service.
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind(("127.0.0.1", preferred))
        except OSError as exc:
            raise RuntimeError(
                f"localhost port {preferred} is already in use; stop that process or run the existing Living System"
            ) from exc
    return preferred


def start(canopy_root: Path, *, preferred_port: int, open_browser: bool) -> str:
    runtime = running_runtime(canopy_root)
    if runtime:
        reconcile_canopy_hooks(canopy_root, mode="installed")
        url = f"http://127.0.0.1:{int(runtime['port'])}"
        if open_browser:
            webbrowser.open(url)
        return url

    needs_install = not venv_python().is_file() or not (ROOT / "dist" / "index.html").is_file()
    if needs_install:
        install(canopy_root)
    else:
        reconcile_canopy_hooks(canopy_root, mode="installed")

    port = available_port(preferred_port)
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    log_handle = LOG_FILE.open("a", encoding="utf-8")
    env = {
        **os.environ,
        "CANOPY_ROOT": str(canopy_root),
        "CANOPY_LIVING_SYSTEM_DATA_DIR": str(DATA_DIR),
        "CANOPY_OBSERVATORY_DATA_DIR": str(DATA_DIR),
    }
    process = subprocess.Popen(
        [
            str(venv_python()),
            "-m",
            "uvicorn",
            "backend.app.main:app",
            "--host",
            "127.0.0.1",
            "--port",
            str(port),
            "--no-access-log",
        ],
        cwd=ROOT,
        env=env,
        stdout=log_handle,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    url = f"http://127.0.0.1:{port}"
    for _ in range(80):
        if process.poll() is not None:
            raise RuntimeError(f"Living System exited during startup; inspect {LOG_FILE}")
        if endpoint_healthy(port, canopy_root):
            break
        time.sleep(0.15)
    else:
        process.terminate()
        raise RuntimeError(f"Living System did not become healthy; inspect {LOG_FILE}")

    RUNTIME_FILE.write_text(
        json.dumps(
            {
                "schema_version": 1,
                "pid": process.pid,
                "port": port,
                "url": url,
                "canopy_root": str(canopy_root),
                "started_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            },
            ensure_ascii=False,
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )
    if open_browser:
        webbrowser.open(url)
    return url


def stop() -> bool:
    runtime = load_runtime()
    try:
        pid = int(runtime.get("pid", 0))
    except (TypeError, ValueError):
        pid = 0
    if not process_alive(pid):
        RUNTIME_FILE.unlink(missing_ok=True)
        return False
    try:
        port = int(runtime.get("port", 0))
        runtime_root = Path(str(runtime.get("canopy_root", ""))).resolve()
    except (TypeError, ValueError):
        raise RuntimeError("Runtime identity is invalid; refusing to signal an unverified process")
    if not endpoint_healthy(port, runtime_root):
        raise RuntimeError("Runtime identity does not match the Living System; refusing to signal the recorded PID")
    os.kill(pid, signal.SIGTERM)
    for _ in range(40):
        if not process_alive(pid):
            break
        time.sleep(0.1)
    if process_alive(pid):
        raise RuntimeError("Living System did not stop within 4 seconds; runtime record was preserved")
    RUNTIME_FILE.unlink(missing_ok=True)
    return True


def doctor(canopy_root: Path) -> int:
    try:
        selected_node, selected_node_version = discover_node()
        node_status = "PASS" if int(selected_node_version.lstrip("v").split(".", 1)[0]) >= 20 else "FAIL"
        node_detail = f"{selected_node_version} ({selected_node})"
    except (RuntimeError, ValueError) as exc:
        node_status = "FAIL"
        node_detail = str(exc)
    checks = [
        ("PASS" if (canopy_root / "canopy").is_file() else "FAIL", "Canopy", str(canopy_root)),
        ("PASS" if sys.version_info >= (3, 11) else "FAIL", "Python", sys.version.split()[0]),
        (node_status, "Node", node_detail),
        ("PASS" if shutil.which("npm") else "FAIL", "npm", shutil.which("npm") or "missing"),
        ("PASS" if venv_python().is_file() else "INFO", "Python environment", str(ROOT / ".venv")),
        ("PASS" if (ROOT / "dist" / "index.html").is_file() else "INFO", "Frontend build", str(ROOT / "dist")),
        ("PASS" if running_runtime(canopy_root) else "INFO", "Local service", str(load_runtime().get("url", "stopped"))),
    ]
    for status, name, detail in checks:
        print(f"[{status}] {name}: {detail}")
    return 1 if any(status == "FAIL" for status, _, _ in checks) else 0


def sync_projection(canopy_root: Path) -> dict[str, object]:
    runtime = running_runtime(canopy_root)
    if runtime:
        port = int(runtime["port"])
        request = urllib.request.Request(
            f"http://127.0.0.1:{port}/api/sync",
            data=b"",
            method="POST",
            headers={"Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(request, timeout=180) as response:
                payload = json.loads(response.read().decode("utf-8"))
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", errors="replace")[:500]
            raise RuntimeError(f"living system sync rejected: {detail}") from exc
        if not isinstance(payload, dict):
            raise RuntimeError("living system sync returned an invalid response")
        return payload

    if not venv_python().is_file():
        raise RuntimeError("Living System is not installed; run ./living-system start first")
    script = (
        "import asyncio, json\n"
        "from backend.app.main import initialize_runtime, snapshot_sync_state, sync_snapshot\n"
        "initialize_runtime()\n"
        "snapshot = asyncio.run(sync_snapshot())\n"
        "print(json.dumps({'snapshot': {'generated_at': snapshot.get('generated_at', '')}, "
        "'sync': snapshot_sync_state}, ensure_ascii=False))\n"
    )
    env = {
        **os.environ,
        "CANOPY_ROOT": str(canopy_root),
        "CANOPY_LIVING_SYSTEM_DATA_DIR": str(DATA_DIR),
        "CANOPY_OBSERVATORY_DATA_DIR": str(DATA_DIR),
    }
    result = run([str(venv_python()), "-c", script], timeout=240, env=env)
    require_success(result, "living system sync")
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"living system sync returned invalid JSON: {exc}") from exc
    if not isinstance(payload, dict):
        raise RuntimeError("living system sync returned an invalid response")
    return payload


def update(canopy_root: Path) -> None:
    stop()
    if (ROOT / ".git").is_dir():
        status = run(["git", "status", "--porcelain"])
        require_success(status, "git status")
        if status.stdout.strip():
            raise RuntimeError("Living System has local changes; update stopped without modifying them")
        require_success(run(["git", "pull", "--ff-only"]), "git update")
    install(canopy_root)


def uninstall(canopy_root: Path) -> None:
    stop()
    reconcile_canopy_hooks(canopy_root, mode="core")
    for path in (ROOT / ".venv", ROOT / "node_modules", ROOT / "dist", DATA_DIR):
        if path.is_dir():
            shutil.rmtree(path)
        elif path.exists():
            path.unlink()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Canopy Living System lifecycle")
    subparsers = parser.add_subparsers(dest="command", required=True)
    for command in ("install", "doctor", "update"):
        item = subparsers.add_parser(command)
        item.add_argument("--canopy-root", default="")
    start_parser = subparsers.add_parser("start")
    start_parser.add_argument("--canopy-root", default="")
    start_parser.add_argument("--port", type=int, default=8765)
    start_parser.add_argument("--no-open", action="store_true")
    sync_parser = subparsers.add_parser("sync")
    sync_parser.add_argument("--canopy-root", default="")
    sync_parser.add_argument("--json", action="store_true")
    subparsers.add_parser("stop")
    uninstall_parser = subparsers.add_parser("uninstall")
    uninstall_parser.add_argument("--canopy-root", default="")
    subparsers.add_parser("build")
    subparsers.add_parser("visual-test")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    canopy_root = resolve_canopy_root(getattr(args, "canopy_root", ""))
    try:
        if args.command == "install":
            install(canopy_root)
            print("Canopy Living System installed")
        elif args.command == "doctor":
            return doctor(canopy_root)
        elif args.command == "start":
            print(start(canopy_root, preferred_port=args.port, open_browser=not args.no_open))
        elif args.command == "stop":
            print("Canopy Living System stopped" if stop() else "Canopy Living System is not running")
        elif args.command == "sync":
            payload = sync_projection(canopy_root)
            if args.json:
                print(json.dumps(payload, ensure_ascii=False, indent=2))
            else:
                topology = (payload.get("sync") or {}).get("topology", {})
                print(
                    "Canopy Living System synchronized: "
                    f"{topology.get('module_count', 0)} living units, "
                    f"{topology.get('connection_count', 0)} connections verified"
                )
        elif args.command == "update":
            update(canopy_root)
            print("Canopy Living System updated")
        elif args.command == "uninstall":
            uninstall(canopy_root)
            print("Canopy Living System generated runtime removed")
        elif args.command == "build":
            build_frontend()
            print("Canopy Living System frontend built")
        elif args.command == "visual-test":
            npm, node_env = node_tooling()
            result = run([*npm, "run", "visual:test"], env=node_env)
            require_success(result, "visual verification")
            if result.stdout.strip():
                print(result.stdout.strip())
            print("Canopy Living System visual verification passed")
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
        print(f"Canopy Living System error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
